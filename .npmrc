# better-sqlite3 привозит в пакете готовый бинарник (prebuilds/), но npm всё равно
# запускает его install-скрипт, а тот зовёт node-gyp и требует Python. На машине без
# Python из-за этого падала вся установка, поэтому install-скрипты отключены:
# готового бинарника достаточно, собирать нечего.
ignore-scripts=true
